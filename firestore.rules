rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isQiuUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@qiu[.]edu[.]my$')
        && request.auth.token.email_verified == true;
    }

    // =========================
    // LISTINGS
    // =========================
    match /listings/{listingId} {

      allow read: if isQiuUser();

      // New listings start as 'active'. 'in_trade' / 'traded' are set only by
      // the backend (admin SDK), never by a client.
      allow create: if isQiuUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active';

      // Owners can edit or remove a listing only while it is 'active', so an
      // item cannot be changed or pulled out from under a trade in progress.
      allow update: if isQiuUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && resource.data.get('status', 'active') == 'active'
        && request.resource.data.get('status', 'active') == 'active';

      allow delete: if isQiuUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.get('status', 'active') == 'active';
    }

    // =========================
    // PREFERENCES / "I WANT"
    // =========================
    match /preferences/{prefId} {

      allow read: if isQiuUser()
        && resource.data.userId == request.auth.uid;

      // Clients may only submit the raw request. 'status' must start as
      // 'pending' and 'normalized' can never be supplied: otherwise a user
      // could skip the AI step and inject arbitrary matching fields (or text
      // that is later shown to the AI arbiter). Size is capped to bound the
      // cost of each LLM call.
      allow create: if isQiuUser()
        && request.resource.data.keys().hasOnly(
             ['userId', 'rawText', 'submittedAt', 'status'])
        && request.resource.data.keys().hasAll(['userId', 'rawText', 'status'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.rawText is string
        && request.resource.data.rawText.size() > 0
        && request.resource.data.rawText.size() <= 500
        && (!('submittedAt' in request.resource.data)
            || request.resource.data.submittedAt == request.time);

      allow update, delete: if false;
    }

    // =========================
    // MATCHES
    // =========================
    match /matches/{matchId} {

      // Only the people in the cycle can see a match (not every student).
      allow read: if isQiuUser()
        && request.auth.uid in resource.data.cycle;

      // Matches are created/deleted only by the trusted backend.
      allow create, delete: if false;

      // Clients can only confirm/decline and mark receipt for themselves.
      //   pending -> confirmed  : only when every participant confirmed
      //   confirmed -> completed: only when every participant marked
      //                           "received"
      // Once a match is completed or declined it is frozen.
      allow update: if isQiuUser()
        && request.auth.uid in resource.data.cycle
        && resource.data.get('status', 'pending') in ['pending', 'confirmed']
        // A pending match past its deadline can no longer be confirmed or
        // declined by a client; the backend flips it to 'expired'.
        && (resource.data.get('status', 'pending') != 'pending'
            || resource.data.get('expiresAt', null) == null
            || request.time < resource.data.expiresAt)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['confirmations', 'receipts', 'status', 'declinedBy'])
        && request.resource.data.get('confirmations', {})
             .diff(resource.data.get('confirmations', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('receipts', {})
             .diff(resource.data.get('receipts', {}))
             .affectedKeys().hasOnly([request.auth.uid])
        // Receipts can only be recorded once the trade is confirmed.
        && (request.resource.data.get('receipts', {})
              .diff(resource.data.get('receipts', {}))
              .affectedKeys().size() == 0
            || resource.data.get('status', 'pending') == 'confirmed')
        && request.resource.data.get('status', 'pending')
             in ['pending', 'confirmed', 'declined', 'completed']
        // declinedBy is optional, but if present it must be the decliner
        // themselves and only together with status 'declined'. The backend
        // uses it so the decliner is not offered the same swap again.
        && (request.resource.data.get('declinedBy', null) == null
            || (request.resource.data.declinedBy == request.auth.uid
                && request.resource.data.get('status', 'pending') == 'declined'))
        && (request.resource.data.get('status', 'pending') != 'confirmed'
            || request.resource.data.get('confirmations', {}).keys()
                 .hasAll(request.resource.data.cycle))
        && (request.resource.data.get('status', 'pending') != 'completed'
            || (resource.data.get('status', 'pending') == 'confirmed'
                && request.resource.data.get('receipts', {}).keys()
                     .hasAll(request.resource.data.cycle)));

      // =========================
      // PRIVATE 1-TO-1 CHATS
      // Path: matches/{matchId}/chats/{chatId}/messages/{messageId}
      // chatId = the two participant UIDs, sorted and joined with '_'
      // (see ChatScreen.chatIdFor in chat_screen.dart)
      // =========================
      match /chats/{chatId}/messages/{messageId} {

        // Only the two people in this chat, and only if they are in the match cycle.
        allow read: if isQiuUser()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.cycle
          && request.auth.uid in chatId.split('_');

        allow create: if isQiuUser()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.cycle
          && request.auth.uid in chatId.split('_')
          && request.resource.data.senderId == request.auth.uid
          // Only known message types.
          && request.resource.data.get('type', 'text') in ['text', 'image', 'location']
          // Locations must carry numeric coordinates.
          && (request.resource.data.get('type', 'text') != 'location'
              || (request.resource.data.lat is number && request.resource.data.lng is number));

        allow update, delete: if false;
      }
    }

    // =========================
    // REVIEWS (ratings + testimonials after a completed trade)
    // Doc id = {matchId}_{reviewerUid}  -> one review per match per person
    // =========================
    match /reviews/{reviewId} {

      allow read: if isQiuUser();

      allow create: if isQiuUser()
        && request.resource.data.keys().hasOnly(
             ['matchId', 'reviewerId', 'revieweeId', 'rating', 'comment', 'createdAt'])
        && reviewId == request.resource.data.matchId + '_' + request.auth.uid
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.revieweeId != request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 300
        && request.resource.data.createdAt == request.time
        // Both people must belong to a COMPLETED match.
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'completed'
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.cycle
        && request.resource.data.revieweeId in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.cycle;

      // Reviews are permanent.
      allow update, delete: if false;
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {

      // Profiles are looked up one at a time (names/photos in cycles, chats
      // and reviews); nobody can list or scrape the whole collection.
      allow get: if isQiuUser();
      allow list: if false;

      // Only these fields may exist. The email is deliberately NOT stored
      // here: the app shows your own email straight from your sign-in.
      allow create, update: if isQiuUser()
        && userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'photoUrl', 'lastSeen',
              'consentVersion', 'consentAcceptedAt']);

      allow delete: if isQiuUser()
        && userId == request.auth.uid;
    }
  }
}
